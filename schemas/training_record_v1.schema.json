{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stagerecon.local/schemas/training_record_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sample_id",
    "control_contract",
    "control_contract_sha256",
    "previs_video",
    "reference_bank",
    "prompt",
    "target_video",
    "mtss_path"
  ],
  "properties": {
    "schema_version": {"const": "training_record_v1"},
    "sample_id": {"type": "string"},
    "control_contract": {"const": "previs_control_v1"},
    "control_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "previs_video": {"type": "string"},
    "reference_bank": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref_id", "images"],
        "properties": {
          "ref_id": {"type": "string"},
          "images": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "prompt": {"type": "string", "minLength": 1},
    "target_video": {"type": "string"},
    "mtss_path": {"type": "string"}
  }
}
