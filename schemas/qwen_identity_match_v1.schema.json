{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stagerecon.local/schemas/qwen_identity_match_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["bindings"],
  "properties": {
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["track_id", "ref_id", "confidence", "reason"],
        "properties": {
          "track_id": {"type": "integer", "minimum": 0},
          "ref_id": {"type": ["string", "null"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
